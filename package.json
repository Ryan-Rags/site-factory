{
  "name": "site-factory",
  "version": "0.0.0",
  "private": true,
  "description": "Lead audit + outreach pipeline and a config-driven template for local business websites.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean",
    "typecheck": "pnpm -r typecheck",
    "discover": "node packages/discover/dist/cli.js",
    "audit-sites": "node packages/audit/dist/cli.js",
    "outreach": "node packages/outreach/dist/cli.js",
    "copy": "node packages/copy/dist/cli.js",
    "copy:report": "node packages/copy/dist/cli.js report",
    "copy:emit": "node packages/copy/dist/cli.js emit --all",
    "demo": "node packages/prospect/dist/cli.js",
    "mockup": "node scripts/mockup/index.mjs",
    "mockup:all": "node scripts/mockup/index.mjs --all",
    "deploy:mockups": "node scripts/deploy/deploy-mockups.mjs",
    "pitch": "node scripts/pitch/compare.mjs",
    "pitch:all": "node scripts/pitch/compare.mjs --all",
    "verify:offline": "node scripts/pitch/verify-offline.mjs",
    "verify:offline:all": "node scripts/pitch/verify-offline.mjs --all --local",
    "lint": "echo \"lint: not configured yet\"",
    "test": "echo \"test: not configured yet\""
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
