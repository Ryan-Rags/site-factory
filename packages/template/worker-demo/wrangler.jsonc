{
  // The SHARED demo contact-form Worker. One deployment behind every prospect
  // demo; the single-client Worker in ../worker/ is a separate thing and is
  // what a real client eventually gets.
  //
  // The ids below are PLACEHOLDERS. This file cannot deploy as written —
  // `wrangler deploy` rejects the placeholder KV id rather than publishing to
  // somebody else's account. Fill them in from your own dashboard.
  //
  // NOTHING SECRET GOES IN THIS FILE. It is committed. `RESEND_API_KEY` is set
  // with `wrangler secret put RESEND_API_KEY` and lives only in Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-factory-demo-form",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Exact origins. Localhost is here so the form can be exercised against a
    // local `pnpm dev` or a served `dist/` before anything is deployed.
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321",

    // Host suffixes. Demo sites are deployed one Pages project per prospect
    // (`<slug>-preview.pages.dev`), and a new project appears with each new
    // prospect — enumerating them here would mean a Worker redeploy per
    // prospect, and the first time that was forgotten the form would fail in
    // front of somebody. Matched at a dot boundary, https only: see
    // src/lib/http.ts.
    "ALLOWED_ORIGIN_SUFFIXES": "pages.dev",

    // Which prospects may post here. Must match the clients/index.ts registry;
    // `scripts/check-form-fields.mjs` fails the build when the two drift.
    // Anything not listed is refused, so this list is what stops a shared
    // endpoint from being an open relay — and a slug missing here means that
    // demo's form 422s in front of a prospect.
    //
    // `zz-fixture-phone-optional` is a TEST FIXTURE, not a prospect. It exists
    // to exercise a non-default field rule server-side, and it is never
    // deployed. See clients/zz-fixture-phone-optional.config.ts.
    "KNOWN_PROSPECTS": "kh-machine-works,kts-machine-shop,american-machine-specialty,industrial-machine-corp,ks-welding,ks-welding-forge,ks-welding-precision,ks-welding-heritage,zz-fixture-phone-optional",

    // Who each prospect's leads belong to: `slug=address,slug=address`.
    // A prospect with no entry falls back to MAIL_TO, which is how every demo
    // behaved before routing existed.
    //
    // PLACEHOLDERS, like MAIL_TO. The real addresses — mine, and a client's
    // once they say yes — live in the gitignored wrangler.local.jsonc. A
    // client's inbox is their data and does not belong in a committed file.
    "PROSPECT_RECIPIENTS": "kh-machine-works=PLACEHOLDER@example.com",

    // Where a lead lands when no prospect entry matches — my own inbox.
    "MAIL_TO": "PLACEHOLDER@example.com",

    // Optional permanent bcc. Once a client goes live and their leads route to
    // them, this is what keeps them visible to me without a forwarding rule in
    // somebody else's mailbox. Deduped against the resolved recipient, so a
    // lead that already comes to me does not arrive twice.
    "BCC_ALWAYS": "",

    // Which fields each prospect's form asks for, and which it insists on:
    // `slug=name!,phone,email,…` — `!` means required, an unlisted field is
    // hidden, a prospect with no entry gets the default rule set. This is the
    // server's copy of `forms.fields` in that client's config, and the build
    // gate fails when the two disagree. See src/lib/fields.ts.
    "PROSPECT_FIELDS": "zz-fixture-phone-optional=name!,phone,email!,message!,file",

    // The visitor's receipt. Off by default, and INERT while MAIL_FROM is on
    // resend.dev — from that sender Resend delivers only to the account owner,
    // so a receipt would never reach the visitor at all. Verify a domain, set
    // MAIL_FROM to an address on it, then flip this. See README.md.
    "CONFIRMATIONS_ENABLED": "false",

    // Resend's free tier sends from onboarding@resend.dev without any DNS
    // setup, and delivers only to the address that owns the Resend account —
    // which is exactly what a demo endpoint needs. Swap this for an address on
    // your own verified domain when you have one. See README.md.
    "MAIL_FROM": "onboarding@resend.dev",

    "MAX_UPLOAD_MB": "10",

    // Per prospect, per hour. A demo form has no legitimate reason to fire
    // more often; this caps what reaches the inbox if a demo URL is found by
    // something automated.
    "PROSPECT_RATE_PER_HOUR": "20"
  },

  "kv_namespaces": [
    {
      // Every submission is written here before the email is attempted, so a
      // mail outage never loses a lead. Also holds the rate-limit counters.
      "binding": "SUBMISSIONS",
      "id": "PLACEHOLDER_KV_NAMESPACE_ID"
    }
  ]

  // Optional: uncomment and create the bucket to keep uploaded photos
  // themselves rather than only their metadata.
  // "r2_buckets": [
  //   { "binding": "UPLOADS", "bucket_name": "PLACEHOLDER-demo-uploads" }
  // ]
}
