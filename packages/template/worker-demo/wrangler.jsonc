{
  // The SHARED demo contact-form Worker. One deployment behind every prospect
  // demo; the single-client Worker in ../worker/ is a separate thing and is
  // what a real client eventually gets.
  //
  // The ids below are PLACEHOLDERS. This file cannot deploy as written —
  // `wrangler deploy` rejects the placeholder KV id rather than publishing to
  // somebody else's account. Fill them in from your own dashboard.
  //
  // NOTHING SECRET GOES IN THIS FILE. It is committed. `RESEND_API_KEY` is set
  // with `wrangler secret put RESEND_API_KEY` and lives only in Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-factory-demo-form",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  "vars": {
    // Exact origins. Localhost is here so the form can be exercised against a
    // local `pnpm dev` or a served `dist/` before anything is deployed.
    "ALLOWED_ORIGINS": "http://localhost:4321,http://127.0.0.1:4321",

    // Host suffixes. Demo sites are deployed one Pages project per prospect
    // (`<slug>-preview.pages.dev`), and a new project appears with each new
    // prospect — enumerating them here would mean a Worker redeploy per
    // prospect, and the first time that was forgotten the form would fail in
    // front of somebody. Matched at a dot boundary, https only: see
    // src/lib/http.ts.
    "ALLOWED_ORIGIN_SUFFIXES": "pages.dev",

    // Which prospects may post here. Anything not listed is refused, so this
    // list is what stops a shared endpoint from being an open relay — and a slug
    // missing here means that demo's form 422s in front of a prospect.
    //
    // It must equal `clients/index.ts` ∪ `prospects/known.json`, in both
    // directions; `scripts/check-form-fields.mjs` fails the build when they
    // drift. Two lists rather than one because a generated prospect demo has no
    // config under clients/ and never will — its config is built from gitignored
    // `prospects/` and handed to Astro as SITE_CONFIG_FILE. Registering the 50
    // generated demos against the clients-only version of that check is what
    // turned it red with 100 problems in PR #54. Regenerate the second list with
    // `pnpm demo -- --emit-known`.
    //
    // THE 50 GENERATED DEMOS GET NO `PROSPECT_RECIPIENTS` ENTRY, deliberately:
    // every one of their leads falls back to MAIL_TO, which is our own inbox.
    // A demo is a pitch, the shop has not agreed to hear from us, and routing
    // enquiries to an address off a scraped listing would put our pitch traffic
    // in somebody else's mailbox. Routing changes when they say yes.
    //
    // They get no `PROSPECT_FIELDS` entry either: they emit no `forms.fields`
    // block, so they resolve to the template's defaults, which are byte-for-byte
    // the defaults in src/lib/fields.ts. Nothing to state, nothing to drift.
    //
    // `zz-fixture-phone-optional` is a TEST FIXTURE, not a prospect. It exists
    // to exercise a non-default field rule server-side, and it is never
    // deployed. See clients/zz-fixture-phone-optional.config.ts.
    //
    // `zz-fixture-go-live` is the second TEST FIXTURE: the one config with
    // `seo.noindex: false`, so the indexable build path is proved somewhere
    // other than a real client's domain. It is listed here only because
    // check-form-fields.mjs requires every registered client to appear — its
    // own `forms.workerEndpoint` is empty, so it posts nowhere, and it is
    // excluded from batch builds and from the deploy script.
    // See clients/zz-fixture-go-live.config.ts.
    //
    // `zz-fixture-long-name` is the third TEST FIXTURE and `zz-fixture-motion`
    // the fourth. Both are here for the same registry reason: the list is
    // asserted in both directions, so a config that exists and is not named
    // here fails the build. Both use the default field rules, so both
    // deliberately get no PROSPECT_FIELDS entry below, and neither is ever
    // deployed. See clients/zz-fixture-long-name.config.ts and
    // clients/zz-fixture-motion.config.ts.
    "KNOWN_PROSPECTS": "kh-machine-works,kts-machine-shop,american-machine-specialty,industrial-machine-corp,ks-welding,ks-welding-forge,ks-welding-precision,ks-welding-heritage,zz-fixture-phone-optional,zz-fixture-go-live,zz-fixture-long-name,zz-fixture-motion,a-and-a-bergen-home-improvements,aaa-construction-and-renovations,ak-welding-llc,auto-tig-fab,avishay-contractors-kitchen-and-bath-remodeling,ben-custom-construction-llc,bliss-construction-llc,c3m-of-nj-home-renovation-affordable-handyman,charles-renovations-construction-company,chavez-and-sons-roofing-and-construction,cnr-construction-and-masonry-llc,cornerstone-roofing-and-restoration,dalmatia-roofing,dior-construction,done-by-brandon-llc-home-improvement-and-gc,e-and-e-construction-llc,elite-work-exterior-and-roofing,elvis-construction-llc-masonry,established-construction,euro-pro-construction,fc-and-sons-construction-corporation,fenomenal-iron-works-llc,frank-conforti-contracting,fsg-construction-llc,geotower-construction-llc,gnc-general-construction-llc,grand-nj-construction,hadodo-construction,hdl-construction-llc,hudson-metal-works,iwmi-projects,jersey-railing-and-welding,jes-roofing-and-general-construction-llc,levy-home-remodeling,lt-construction-services-llc,mark-fanella-construction-co,mayfair-remodeling,nj-premium-construction,nuvista-designs-general-contractors-llc,perfect-welder-fabrication-and-repair,pro-build-construction,pro-excellent-construction-llc,r-and-r-building-services-nj,skyline-roof-repairs-and-replacement,top-choice-construction-llc,top-performer-construction-llc,trussty-hand-llc-construction,universal-roofing-and-chimney,work-pro-construction,ztm-construction-llc",

    // Who each prospect's leads belong to: `slug=address,slug=address`.
    // A prospect with no entry falls back to MAIL_TO, which is how every demo
    // behaved before routing existed.
    //
    // PLACEHOLDERS, like MAIL_TO. The real addresses — mine, and a client's
    // once they say yes — live in the gitignored wrangler.local.jsonc. A
    // client's inbox is their data and does not belong in a committed file.
    "PROSPECT_RECIPIENTS": "kh-machine-works=PLACEHOLDER@example.com",

    // Where a lead lands when no prospect entry matches — my own inbox.
    "MAIL_TO": "PLACEHOLDER@example.com",

    // Optional permanent bcc. Once a client goes live and their leads route to
    // them, this is what keeps them visible to me without a forwarding rule in
    // somebody else's mailbox. Deduped against the resolved recipient, so a
    // lead that already comes to me does not arrive twice.
    "BCC_ALWAYS": "",

    // Which fields each prospect's form asks for, and which it insists on:
    // `slug=name!,phone,email,…` — `!` means required, an unlisted field is
    // hidden, a prospect with no entry gets the default rule set. This is the
    // server's copy of `forms.fields` in that client's config, and the build
    // gate fails when the two disagree. See src/lib/fields.ts.
    "PROSPECT_FIELDS": "zz-fixture-phone-optional=name!,phone,email!,message!,file",

    // The visitor's receipt. Off by default, and INERT while MAIL_FROM is on
    // resend.dev — from that sender Resend delivers only to the account owner,
    // so a receipt would never reach the visitor at all. Verify a domain, set
    // MAIL_FROM to an address on it, then flip this. See README.md.
    "CONFIRMATIONS_ENABLED": "false",

    // Resend's free tier sends from onboarding@resend.dev without any DNS
    // setup, and delivers only to the address that owns the Resend account —
    // which is exactly what a demo endpoint needs. Swap this for an address on
    // your own verified domain when you have one. See README.md.
    "MAIL_FROM": "onboarding@resend.dev",

    "MAX_UPLOAD_MB": "10",

    // Per prospect, per hour. A demo form has no legitimate reason to fire
    // more often; this caps what reaches the inbox if a demo URL is found by
    // something automated.
    "PROSPECT_RATE_PER_HOUR": "20"
  },

  "kv_namespaces": [
    {
      // Every submission is written here before the email is attempted, so a
      // mail outage never loses a lead. Also holds the rate-limit counters.
      "binding": "SUBMISSIONS",
      "id": "PLACEHOLDER_KV_NAMESPACE_ID"
    }
  ]

  // Optional: uncomment and create the bucket to keep uploaded photos
  // themselves rather than only their metadata.
  // "r2_buckets": [
  //   { "binding": "UPLOADS", "bucket_name": "PLACEHOLDER-demo-uploads" }
  // ]
}
