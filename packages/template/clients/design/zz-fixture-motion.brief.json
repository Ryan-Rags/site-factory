{
  "theme": {
    "preset": "apex",
    "scheme": "dark",
    "accent": "lime",
    "fontPairing": "grotesk"
  },
  "header": {
    "nav": [
      {
        "label": "What we do",
        "href": "#services"
      },
      {
        "label": "Reviews",
