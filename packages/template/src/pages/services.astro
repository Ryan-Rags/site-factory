---
import { getCollection, render } from 'astro:content';
import { site } from '../../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';

const entries = await getCollection('services');
const byId = new Map(entries.map((e) => [e.id, e]));

// Order follows site.config.ts, not the filesystem. A slug with no matching
// markdown file is a build error rather than a silently missing section.
const services = await Promise.all(
  site.services.map(async (service) => {
    const entry = byId.get(service.slug);
    if (!entry) {
      throw new Error(
        `site.config.ts lists service "${service.slug}" but src/content/services/${service.slug}.md does not exist.`,
      );
    }
    const { Content } = await render(entry);
    return { ...service, entry, Content };
  }),
);
---

<BaseLayout
  title="Services"
  description={`Precision machining, repairs, custom fabrication and welding from ${site.business.name} in ${site.business.address.locality}, ${site.business.address.region}.`}
>
  <PageHeader
    title="What we do"
    intro="Four things, done properly, by the same people who quoted the job. Everything below is available as a one-off — there is no minimum order."
  />

  <nav aria-label="Services" class="border-b border-slate-200 bg-primary-wash">
    <div class="container-page">
      <ul class="flex flex-wrap gap-2 py-4">
        {
          services.map((s) => (
            <li>
              <a
                href={`#${s.slug}`}
                class="inline-flex items-center gap-2 rounded-full border border-primary/25 bg-white px-4 py-2 text-sm font-semibold text-primary hover:bg-primary-wash"
              >
                <Icon name={s.icon} class="h-4 w-4" />
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    services.map((s, i) => (
      <section
        id={s.slug}
        aria-labelledby={`${s.slug}-heading`}
        class:list={['section', i % 2 === 1 && 'bg-slate-50']}
      >
        <div class="container-page">
          <div class="grid items-start gap-10 lg:grid-cols-2 lg:gap-14">
            <div class:list={[i % 2 === 1 && 'lg:order-last']}>
              <img
                src={s.image}
                alt={s.imageAlt}
                width="800"
                height="600"
                loading="lazy"
                decoding="async"
                class="aspect-[4/3] w-full rounded-lg border border-slate-200 object-cover shadow-md"
              />
            </div>

            <div>
              <span class="text-accent-dark">
                <Icon name={s.icon} class="h-8 w-8" />
              </span>
              <h2 id={`${s.slug}-heading`} class="mt-3 text-3xl sm:text-4xl">
                {s.title}
              </h2>
              <p class="mt-3 text-lg font-medium text-slate-700">{s.entry.data.summary}</p>

              <div class="prose-body mt-5 space-y-4 text-base leading-relaxed text-slate-600">
                <s.Content />
              </div>

              <ul class="mt-6 space-y-2">
                {s.entry.data.highlights.map((h) => (
                  <li class="flex items-start gap-3 text-sm font-semibold text-slate-800">
                    <svg
                      class="mt-0.5 h-5 w-5 shrink-0 text-accent-dark"
                      viewBox="0 0 20 20"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m4 10.5 4 4 8-9" />
                    </svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>

              <a class="btn-outline mt-8" href="/contact">
                Ask about {s.title.toLowerCase()}
              </a>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <CtaBand />
</BaseLayout>

<style>
  /* Markdown body copy inside a service section. Scoped, so it cannot leak. */
  .prose-body :global(p + p) {
    margin-top: 1rem;
  }
</style>
