---
/**
 * The page shell for a design-family site.
 *
 * It is a sibling of `BaseLayout`, not a replacement: a client whose config
 * carries no `design` block still renders through the original layout.
 * Everything family-specific enters here as custom properties resolved from
 * the client's chosen preset, so this file names no colour and no font.
 *
 * Two emission modes:
 *
 * - **delivered** (the default) — one `:root` block for the theme the client
 *   chose. No matrix, no panel, no extra script.
 * - **pitch** (`features.customizer`) — the whole preset matrix as static CSS
 *   keyed on `<html data-theme|data-scheme|data-accent|data-font>`, a small
 *   blocking script that resolves and stamps those attributes before first
 *   paint, and the panel.
 *
 * The mode is decided here rather than inside the customizer so there is one
 * place to look when asking "can this build leak the panel?". `SITE_DELIVERED`
 * overrides the config, because the dangerous case is a pitch flag left on.
 */
import { site, clientSlug } from '../../../site.config';
import Seo from '../Seo.astro';
import LocalBusinessJsonLd from '../LocalBusinessJsonLd.astro';
import Reveal from './Reveal.astro';
import Customizer from './Customizer.astro';
import ServiceWorker from '../ServiceWorker.astro';
import { designTokens, offeredIds, themeMatrixCss } from '../../lib/design';
import { resolveTheme } from '../../design/presets';
import type { DesignConfig } from '../../types/design';
import '../../styles/design.css';
import '../../styles/design-life.css';

interface Props {
  design: DesignConfig;
  title: string;
  description?: string | undefined;
  bareTitle?: boolean | undefined;
  /** LCP image, preloaded. The hero's, on every family. */
  preloadImage?: string | undefined;
}

const { design, title, description, bareTitle = false, preloadImage } = Astro.props;
const { brand, business, features } = site;

const theme = resolveTheme(design.theme);
const faces = theme.fonts.faces ?? [];

/**
 * A delivery build must not carry the panel even if somebody left the flag on
 * in the config, so the env var can only ever turn it *off*.
 */
const delivered = process.env['SITE_DELIVERED'] === '1';
const customizer = features.customizer === true && !delivered;

/**
 * Height reserved at the foot of the page for the sticky call bar. Without it
 * the last section's final line sits permanently underneath the bar. The media
 * query in design.css drops it back to zero where the bar is hidden.
 */
const callbarSpace = design.sections.stickyCta.enabled ? '5.5rem' : '0rem';

const tokens = customizer
  ? `${designTokens(theme)}\n${themeMatrixCss(design)}`
  : designTokens(theme);

/**
 * The no-flash script. URL params win (so a shared link lands on the right
 * combination), then localStorage, then the config's own selection. It is
 * inline and blocking in `<head>` on purpose: stamping the attributes after
 * first paint is what a theme flash *is*.
 */
/*
 * `data-theme` is stamped on <html> even for delivered builds, where nothing
 * will ever change it. The family's decorative rules in design.css key off
 * it, so the customizer switching one attribute switches the texture, the
 * corner ticks and the rules along with the palette — rather than repainting
 * a Forge page's colours while it keeps Precision's blueprint grid.
 *
 * `data-scheme` is emitted on pitch builds only, unlike `data-theme`.
 * `data-theme` earns its place on a delivered page: `design.css` keys its
 * decorative rules off it, so a family's texture and rules follow it. Nothing
 * keys off `data-scheme` — a delivered page receives its tone already
 * resolved, inside the single `:root` token block — so there the attribute
 * would be an inert string that changes the bytes of eight shipped client
 * sites and nothing about how they render.
 *
 * This note lives in the frontmatter, and must stay there. Both obvious
 * places to put it in the template are traps — and the second one was walked
 * into again while adding the scheme axis, which is why the parity check now
 * compares the `<html>` tag as a region of its own:
 *
 *   - an Astro `{/* … *\/}` expression above <html> makes the compiler treat
 *     the file as a fragment and silently drop <html>, <head> and <body>;
 *   - an HTML comment above <!doctype html> builds fine and *looks* fine, but
 *     the doctype is then no longer the first thing in the document, so the
 *     browser renders in quirks mode and stops sniffing the charset from the
 *     <meta> tag. It cost a Lighthouse run reporting NO_LCP and a mojibake
 *     em dash in every <title> to find that.
 */
/*
 * It resolves rather than obeys. A URL parameter or a localStorage entry can
 * name a combination that does not exist — a link shared before a swatch was
 * renamed, a hand-edited address, or an accent carried over from another
 * preset, whose ids are disjoint. Stamping it anyway is what produced the
 * stale-accent bug: the attribute pointed at a cell the matrix never emitted,
 * so the accent silently fell back to this client's shipped `:root` colour and
 * the page showed one family's orange over another family's cream.
 *
 * `offeredIds()` is the id skeleton of the very CSS emitted above, so what
 * this accepts and what has styles cannot drift apart.
 */
const noFlash = `(function(){try{
var d=document.documentElement,q=new URLSearchParams(location.search),s={};
try{s=JSON.parse(localStorage.getItem('sf-theme')||'{}')||{}}catch(e){}
var M=${JSON.stringify(offeredIds(design))},F=${JSON.stringify({
  theme: theme.preset.id,
  scheme: theme.scheme,
  accent: design.theme.accent,
  font: design.theme.fontPairing,
})};
var t=q.get('theme')||s.theme||F.theme;if(!M[t])t=F.theme;
var o=M[t];
var c=q.get('scheme')||s.scheme||(t===F.theme?F.scheme:o.d);if(!o.s[c])c=o.d;
var a=q.get('accent')||s.accent||F.accent;if(o.s[c].indexOf(a)<0)a=o.s[c][0];
var f=q.get('font')||s.font||F.font;if(o.f.indexOf(f)<0)f=o.f[0];
d.setAttribute('data-theme',t);d.setAttribute('data-scheme',c);
d.setAttribute('data-accent',a);d.setAttribute('data-font',f);
}catch(e){}})();`;
---

<!doctype html>
<html
  lang="en"
  data-theme={theme.preset.id}
  data-scheme={customizer ? theme.scheme : undefined}
  data-accent={design.theme.accent}
  data-font={design.theme.fontPairing}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={brand.favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`/icons/${clientSlug}/apple-touch-icon.png`} />
    <link rel="manifest" href={`/icons/${clientSlug}/site.webmanifest`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={theme.palette.primary} />

    <Seo title={title} description={description} bare={bareTitle} />

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {
      faces.map((f) => (
        <link rel="preload" as="font" type="font/woff2" href={f.src} crossorigin="anonymous" />
      ))
    }

    <style is:global set:html={tokens} />
    {
      faces.length > 0 && (
        <style
          is:global
          set:html={faces
            .map(
              (f) => `@font-face {
  font-family: ${JSON.stringify(f.family)};
  src: url(${JSON.stringify(f.src)}) format("woff2");
  font-weight: ${f.weight};
  font-style: ${f.style};
  font-display: ${f.display};
}`,
            )
            .join('\n')}
        />
      )
    }

    {customizer && <script is:inline set:html={noFlash} />}

    <LocalBusinessJsonLd />
  </head>

  <body
    data-family={theme.preset.id}
    data-timezone={business.timezone ?? undefined}
    style={`--d-callbar-space: ${callbarSpace}; display: flex; min-height: 100vh; flex-direction: column;`}
  >
    <a href="#main" class="d-skip">Skip to main content</a>

    <slot />

    {customizer && <Customizer design={design} />}

    <Reveal />

    <ServiceWorker />
  </body>
</html>

<style is:global>
  /*
   * Minimal reset, scoped to the design shell. `global.css` is Tailwind's
   * preflight plus the base template's own base layer; a design-family page
   * does not load it, so the handful of resets it actually depends on live
   * here instead. Loading two full stylesheets to reuse six rules would cost
   * more bytes than it saves.
   */
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
    /* Anchored sections clear the sticky header. */
    scroll-padding-top: 5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    /* Belt and braces against horizontal overflow at 320px: nothing may
       widen the page, whatever a long part number or wide image does. */
    overflow-x: hidden;
  }

  img,
  svg,
  video {
    display: block;
    max-width: 100%;
    height: auto;
  }

  p,
  li,
  dd,
  dt,
  address {
    overflow-wrap: break-word;
  }

  p {
    text-wrap: pretty;
  }

  .d-skip {
    /*
     * Clipped rather than pushed to `left: -9999px`. The off-screen trick
     * plants a painted box far outside the layout viewport, and under mobile
     * emulation that was enough to stop Chrome reporting a Largest Contentful
     * Paint for the page at all — which is why Lighthouse could score every
     * other metric here and not performance.
     */
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    left: 0;
    top: 0;
    z-index: 100;
    padding: 0.85rem 1.25rem;
    background: var(--d-accent);
    color: var(--d-on-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .d-skip:focus {
    width: auto;
    height: auto;
    overflow: visible;
    clip: auto;
    left: 1rem;
    top: 1rem;
  }

  .d-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
