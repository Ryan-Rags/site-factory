---
/**
 * Work gallery.
 *
 * Every image is lazy and carries intrinsic dimensions, so the grid reserves
 * its full height on first paint and a twelve-image gallery costs nothing
 * above the fold. Captions are optional — a caption that just repeats the alt
 * text is noise, so the config omits it rather than duplicating.
 */
import type { GallerySection } from '../../types/design';

interface Props {
  gallery: GallerySection;
}

const { gallery } = Astro.props;
---

<section class="d-section d-gallery" id="gallery" aria-labelledby="gallery-heading">
  <div class="d-wrap">
    <div class="d-head" data-reveal>
      {gallery.eyebrow && <p class="d-eyebrow">{gallery.eyebrow}</p>}
      <h2 class="d-h2" id="gallery-heading">{gallery.heading}</h2>
      {gallery.intro && <p class="d-lede">{gallery.intro}</p>}
    </div>

    <div class="d-gallery__grid">
      {
        gallery.items.map((item, i) => (
          <figure data-reveal style={`--d-reveal-delay: ${(i % 3) * 80}ms`}>
            <img
              src={item.src}
              alt={item.alt}
              width={item.width ?? 800}
              height={item.height ?? 800}
              loading="lazy"
              decoding="async"
            />
            {item.caption && <figcaption>{item.caption}</figcaption>}
          </figure>
        ))
      }
    </div>
  </div>
</section>
