---
import { site } from '../../site.config';

interface Props {
  /** First couple of paragraphs of the story, rendered as plain text. */
  excerpt: string;
}

const { excerpt } = Astro.props;
const { about, business } = site;
---

<section class="section" aria-labelledby="story-heading">
  <div class="container-page">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <p class="eyebrow">Who you're dealing with</p>
        <h2 id="story-heading" class="mt-3 text-3xl sm:text-4xl">{about.headline}</h2>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{excerpt}</p>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">
          Serving {business.serviceArea.slice(0, 4).join(', ')} and the surrounding area.
        </p>
        <a class="btn-outline mt-8" href="/about">Read our story</a>
      </div>

      <div class="lg:order-first">
        <img
          src={about.image}
          alt={about.imageAlt}
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
          class="w-full rounded-lg border border-slate-200 shadow-md"
        />
      </div>
    </div>
  </div>
</section>
