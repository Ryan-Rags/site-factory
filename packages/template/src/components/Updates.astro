---
import { site } from '../../site.config';

/**
 * Shop news. Renders nothing when `updates` is absent or empty.
 *
 * Sorted newest-first here rather than trusting config order, so a client
 * appending an entry to the end of the array still gets it at the top.
 */
const updates = [...(site.updates ?? [])].sort((a, b) => b.date.localeCompare(a.date));

/**
 * An unconfirmed date is a real case: an update can be drafted before the
 * client confirms when it happened, and `date` then carries the verify
 * marker. Emitting that as `<time datetime="[verify with client]">` would be
 * invalid HTML, so a non-ISO date renders as plain text instead.
 */
const ISO_DATE = /^\d{4}-\d{2}-\d{2}$/;

const fmtDate = (iso: string) => {
  const d = new Date(`${iso}T00:00:00Z`);
  return Number.isNaN(d.valueOf())
    ? iso
    : d.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      });
};
---

{
  updates.length > 0 && (
    <section class="section" aria-labelledby="updates-heading">
      <div class="container-page">
        <p class="eyebrow">Shop news</p>
        <h2 id="updates-heading" class="mt-3 text-3xl sm:text-4xl">
          What's new
        </h2>

        <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {updates.map((u) => (
            <li class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
              {ISO_DATE.test(u.date) ? (
                <time datetime={u.date} class="text-sm font-semibold text-accent-dark">
                  {fmtDate(u.date)}
                </time>
              ) : (
                <span class="text-sm font-semibold text-accent-dark">{u.date}</span>
              )}
              <h3 class="mt-2 font-heading text-lg font-bold text-slate-900">{u.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-slate-600">{u.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
