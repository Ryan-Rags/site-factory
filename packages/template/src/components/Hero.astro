---
import { site } from '../../site.config';
import { smsHref, telHref } from '../lib/business';

const { hero, business } = site;
const canText = smsHref(business) !== null;
---

<section class="bg-primary text-white">
  <div class="container-page">
    <div class="grid items-center gap-10 py-14 sm:py-20 lg:grid-cols-2 lg:gap-14">
      <div>
        <p class="text-sm font-bold uppercase tracking-widest text-white/70">
          {business.address.locality}, {business.address.region} &middot; Est. {business.foundedYear}
        </p>
        <h1 class="mt-4 text-4xl font-extrabold leading-[1.1] text-white sm:text-5xl lg:text-[3.4rem]">
          {hero.headline}
        </h1>
        <p class="mt-5 max-w-prose text-lg leading-relaxed text-white/85">{hero.subhead}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a class="btn-primary" href={hero.ctaPrimary.href}>{hero.ctaPrimary.text}</a>
          <a class="btn-secondary" href={hero.ctaSecondary.href}>{hero.ctaSecondary.text}</a>
        </div>

        {/*
          Written as one unbroken expression per side of the conditional: a
          newline between expressions becomes a stray space in the output, and
          the em dash must sit tight against the number when there is no text
          link to follow it.
        */}
        <p class="mt-6 text-sm text-white/75">
          Or call us direct:{' '}
          <a class="font-bold text-white underline underline-offset-4" href={telHref(business)}>{business.phone}</a
          >{canText && (<Fragment>{' — or '}<a class="font-bold text-white underline underline-offset-4" href={smsHref(business)!}>send a text</a></Fragment>)}
        </p>
      </div>

      <div class="lg:justify-self-end">
        <img
          src={hero.image}
          alt={hero.imageAlt}
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
          class="w-full rounded-lg border border-white/15 shadow-2xl"
        />
      </div>
    </div>
  </div>
</section>
