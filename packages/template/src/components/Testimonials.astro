---
import { site } from '../../site.config';

const { testimonials } = site;

/**
 * Any testimonial still marked `placeholder` renders a visible warning banner.
 * That is deliberate: it is impossible to send this site to a client, or show
 * it to their customers, without noticing that the words are ours and not a
 * real reviewer's. The banner disappears the moment every entry is `verified`.
 */
const hasPlaceholder = testimonials.some((t) => t.status === 'placeholder');
---

<section class="section bg-slate-50" aria-labelledby="testimonials-heading">
  <div class="container-page">
    <div class="max-w-prose">
      <p class="eyebrow">In their words</p>
      <h2 id="testimonials-heading" class="mt-3 text-3xl sm:text-4xl">What customers say</h2>
    </div>

    {
      hasPlaceholder && (
        <div
          role="note"
          class="mt-8 rounded-lg border-2 border-dashed border-accent-dark bg-accent-wash p-4 text-sm leading-relaxed text-slate-800"
        >
          <strong class="font-bold">Placeholder copy — not customer wording.</strong> The quotes
          below were written by us from what the client told us about their reviews. No review text
          was copied from anywhere. Replace them with client-supplied wording, or delete the
          section, before this site is shown to anyone outside the shop. See README step 3.
        </div>
      )
    }

    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {
        testimonials.map((t) => (
          <li class="flex h-full flex-col rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
            <p class="flex items-center gap-0.5">
              {/* Visually-hidden text rather than aria-label: a <p> has no
                  role that permits aria-label, and screen readers ignore it. */}
              <span class="sr-only">Rated {t.rating} out of 5</span>
              {Array.from({ length: 5 }, (_, i) => (
                <svg
                  class:list={['h-5 w-5', i < t.rating ? 'text-accent' : 'text-slate-300']}
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M10 1.6l2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L1.6 7.7l5.8-.8L10 1.6z" />
                </svg>
              ))}
            </p>

            <blockquote class="mt-4 flex-1">
              <p class="text-lg leading-relaxed text-slate-700">&ldquo;{t.quote}&rdquo;</p>
            </blockquote>

            <div class="mt-5 border-t border-slate-200 pt-4 text-sm">
              <span class="font-bold text-slate-900">{t.attribution}</span>
              <span class="block text-slate-600">{t.role}</span>
              {t.status === 'placeholder' && (
                <span class="mt-2 block font-semibold uppercase tracking-wide text-accent-dark">
                  Placeholder — verify with client
                </span>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
