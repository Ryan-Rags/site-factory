---
import { site } from '../../site.config';

/**
 * The service-area section: one block per town, on one real page.
 *
 * Deliberately NOT a page per town. The per-town page with the name
 * substituted in is the doorway-page pattern, it has been demoted for years,
 * and it is worse for a reader than a single page that says plainly where the
 * business works.
 *
 * The copy itself comes from `@site-factory/copy`, which is forbidden from
 * writing a distance, a drive time or a landmark into these — the invented
 * local detail is what marks this kind of section as automated, and it is the
 * bit a local spots instantly.
 *
 * Renders nothing when `site.serviceAreas` is absent, which is the right
 * outcome for a business whose service area we have not confirmed.
 */
const areas = site.serviceAreas;
---

{
  areas !== undefined && (
    <section class="section" aria-labelledby="service-areas-heading">
      <div class="container-page">
        <h2 id="service-areas-heading" class="text-3xl sm:text-4xl">
          {areas.heading}
        </h2>
        <p class="mt-3 max-w-2xl text-lg text-slate-600">{areas.intro}</p>

        {areas.towns.length > 0 && (
          <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {areas.towns.map((t) => (
              <li class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
                <h3 class="text-xl font-semibold text-slate-900">{t.town}</h3>
                <p class="mt-2 text-base leading-relaxed text-slate-600">{t.body}</p>
              </li>
            ))}
          </ul>
        )}

        {areas.widerLine !== undefined && (
          <p class="mt-8 max-w-3xl text-base text-slate-600">{areas.widerLine}</p>
        )}
      </div>
    </section>
  )
}
