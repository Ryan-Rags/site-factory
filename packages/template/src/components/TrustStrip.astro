---
import { site } from '../../site.config';
import Icon from './Icon.astro';

const { trustStrip } = site;
---

<section class="border-b border-slate-200 bg-primary-wash" aria-label="Why customers use us">
  <div class="container-page">
    <ul class="grid grid-cols-1 gap-x-8 gap-y-5 py-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        trustStrip.map((item) => (
          <li class="flex items-start gap-3">
            <span class="mt-0.5 shrink-0 text-accent-dark">
              <Icon name={item.icon} class="h-6 w-6" />
            </span>
            <span class="text-sm font-semibold leading-snug text-slate-800">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
