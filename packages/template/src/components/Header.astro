---
import { site } from '../../site.config';
import Icon from './Icon.astro';

const { business, brand, features } = site;

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  ...(features.gallery ? [{ href: '/gallery', label: 'Gallery' }] : []),
  { href: '/contact', label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

{/*
  The mobile menu is a <details> element, so it opens and closes with no
  JavaScript at all. The whole site ships zero JS except the contact form.
*/}
<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <div class="container-page">
    <div class="flex items-center justify-between gap-4 py-3">
      {/*
        `min-w-0` + `truncate`: on a 320px phone the logo, the business name
        and the menu button together are wider than the viewport. Letting the
        name shrink and ellipsise is what keeps the page from scrolling
        sideways — a long client name must not be able to widen the layout.
      */}
      <a href="/" class="flex min-w-0 items-center gap-2 rounded-sm sm:gap-3" aria-label={`${business.name} — home`}>
        {/* Decorative: the business name sits right next to it as real text,
            so alt text here would only duplicate what is already announced. */}
        <img src={brand.logo} alt="" width="44" height="44" class="h-10 w-10 shrink-0 sm:h-11 sm:w-11" />
        <span class="truncate font-heading text-base font-extrabold leading-none tracking-tight text-primary sm:text-lg lg:text-xl">
          {business.name}
        </span>
      </a>

      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-1">
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={isCurrent(link.href) ? 'page' : undefined}
                  class:list={[
                    'rounded-md px-3 py-2 text-sm font-semibold transition-colors',
                    isCurrent(link.href)
                      ? 'bg-primary-wash text-primary'
                      : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900',
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
          <li class="ml-2">
            <a
              href={`tel:${business.phoneHref}`}
              class="inline-flex items-center gap-2 rounded-md bg-accent px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-accent-dark"
            >
              <Icon name="phone" class="h-4 w-4" />
              <span>{business.phone}</span>
            </a>
          </li>
        </ul>
      </nav>

      <details class="group relative shrink-0 md:hidden">
        <summary
          class="flex cursor-pointer list-none items-center gap-2 rounded-md border border-slate-300 px-3 py-2 text-sm font-semibold text-slate-800 [&::-webkit-details-marker]:hidden"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
            <path class="hidden group-open:block" d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
          </svg>
          <span class="group-open:hidden">Menu</span>
          <span class="hidden group-open:inline">Close</span>
        </summary>

        <nav
          aria-label="Main"
          class="absolute right-0 top-full z-50 mt-2 w-56 max-w-[calc(100vw-2.5rem)] rounded-lg border border-slate-200 bg-white p-2 shadow-xl"
        >
          <ul>
            {
              links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isCurrent(link.href) ? 'page' : undefined}
                    class:list={[
                      'block rounded-md px-3 py-2.5 text-base font-semibold',
                      isCurrent(link.href) ? 'bg-primary-wash text-primary' : 'text-slate-800',
                    ]}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
            <li class="mt-1 border-t border-slate-200 pt-2">
              <a
                href={`tel:${business.phoneHref}`}
                class="flex items-center gap-2 rounded-md bg-accent px-3 py-2.5 text-base font-bold text-white"
              >
                <Icon name="phone" class="h-4 w-4" />
                <span>{business.phone}</span>
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
