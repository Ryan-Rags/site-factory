---
import { site } from '../../site.config';

/**
 * Capability list. Renders nothing at all when `equipment` is absent or
 * empty — no heading, no empty grid, no stray whitespace. A client we have
 * no machine list for should look like a site that never had the section,
 * not like a site with a broken one.
 */
const equipment = site.equipment ?? [];
---

{
  equipment.length > 0 && (
    <section class="section bg-slate-50" aria-labelledby="equipment-heading">
      <div class="container-page">
        <p class="eyebrow">On the floor</p>
        <h2 id="equipment-heading" class="mt-3 text-3xl sm:text-4xl">
          What we run
        </h2>

        <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {equipment.map((item) => (
            <li class="rounded-lg border border-slate-200 bg-white p-5">
              <p class="font-heading text-base font-bold text-slate-900">{item.name}</p>
              {item.detail && <p class="mt-1 text-sm leading-relaxed text-slate-600">{item.detail}</p>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
