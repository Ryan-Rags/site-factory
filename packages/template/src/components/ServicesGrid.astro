---
import { site } from '../../site.config';
import Icon from './Icon.astro';

interface Props {
  heading: string;
  intro?: string;
  /** Heading level so the grid can sit under an h1 or an h2 correctly. */
  level?: 2 | 3;
}

const { heading, intro, level = 2 } = Astro.props;
const Hx = `h${level}` as const;
const Hy = `h${(level + 1) as 3 | 4}` as const;
---

<section class="section">
  <div class="container-page">
    <div class="max-w-prose">
      <p class="eyebrow">What we do</p>
      <Hx class="mt-3 text-3xl sm:text-4xl">{heading}</Hx>
      {intro && <p class="mt-4 text-lg leading-relaxed text-slate-600">{intro}</p>}
    </div>

    <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        site.services.map((service) => (
          <li class="relative flex h-full flex-col overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md">
            <img
              src={service.image}
              alt={service.imageAlt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="aspect-[4/3] w-full object-cover"
            />
            <div class="flex flex-1 flex-col p-5">
              <span class="text-accent-dark">
                <Icon name={service.icon} class="h-7 w-7" />
              </span>
              <Hy class="mt-3 text-lg">
                <a class="after:absolute after:inset-0" href={`/services#${service.slug}`}>
                  {service.title}
                </a>
              </Hy>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{service.oneLiner}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
