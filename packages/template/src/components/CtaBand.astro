---
import { site } from '../../site.config';
import { telHref } from '../lib/business';
import TextUsLink from './TextUsLink.astro';
import QuickQuote from './QuickQuote.astro';
import { quickQuoteFor } from '../lib/quote-form';

const { cta, business } = site;

/**
 * The quote block joins the band rather than replacing its buttons. Calling is
 * still the fastest route for the customer who is ready to call, and the block
 * is for the one who is not — taking the buttons away to make room would trade
 * a lead for a lead.
 */
const withQuote = quickQuoteFor('cta') !== null;
---

<section class="bg-primary-dark text-white" aria-labelledby="cta-heading">
  <div class="container-page">
    <div class="flex flex-col gap-6 py-12 sm:py-16 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-prose">
        <h2 id="cta-heading" class="text-3xl text-white sm:text-4xl">{cta.headline}</h2>
        <p class="mt-4 text-lg leading-relaxed text-white/85">{cta.body}</p>
      </div>

      <div class="flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
        <a class="btn-primary" href={cta.buttonHref}>{cta.buttonText}</a>
        <a class="btn-secondary" href={telHref(business)}>Call {business.phone}</a>
        <TextUsLink class="btn-secondary" label={`Text ${business.phone}`} icon={false} />
      </div>
    </div>

    {
      withQuote && (
        <div class="pb-12 sm:pb-16">
          <QuickQuote placement="cta" />
        </div>
      )
    }
  </div>
</section>
