{
  "name": "@site-factory/template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Config-driven Astro/Tailwind site template; deploys to Cloudflare Pages.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/check-form-fields.mjs && node scripts/check-injection.mjs && astro build && node scripts/check-markers.mjs && node scripts/check-fabrication.mjs && node scripts/check-contrast.mjs && node scripts/check-contact-links.mjs",
    "build:all": "node scripts/build-all.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check:markers": "node scripts/check-markers.mjs",
    "check:fabrication": "node scripts/check-fabrication.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:switching": "node scripts/check-switching.mjs",
    "check:parity": "node scripts/check-delivered-parity.mjs",
    "check:contact-links": "node scripts/check-contact-links.mjs",
    "check:form-fields": "node scripts/check-form-fields.mjs",
    "check:injection": "node scripts/check-injection.mjs",
    "gen:placeholders": "node scripts/gen-placeholders.mjs",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const d of ['dist','.astro'])rmSync(d,{recursive:true,force:true})\"",
    "gen:brand": "node scripts/gen-brand-assets.mjs",
    "compare": "node scripts/make-compare.mjs",
    "record:switch": "node scripts/record-theme-switch.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/tailwind": "^5.1.5",
    "@site-factory/copy": "workspace:*",
    "astro": "^5.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "playwright": "^1.49.1",
    "puppeteer-core": "^24.1.1",
    "typescript": "^5.7.3"
  }
}
