---
/**
 * The credibility page. A property manager who got a cold email arrives here
 * to answer one question — "is this a real operator or a guy with a mailbox?" —
 * so the job of this page is to look like a founder with three shipping
 * ventures, not to sell any one of them. The selling happens on the child
 * pages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import {
  AMENITY_BRAND,
  CODING_SINCE,
  FULL_NAME,
  HEADSHOT_SRC,
  PAGES,
  PLACEHOLDERS,
  REGION,
  YEARS_PROFESSIONAL,
} from '../site';
import { HAS_HEADSHOT, HEADSHOT_H, HEADSHOT_W } from '../assets';

const ventures = [
  {
    href: '/sites',
    eyebrow: 'site-factory',
    title: 'Websites for local business',
    body:
      'Fast, mobile-first sites for Bergen County businesses — a pipeline I wrote that has generated dozens of sites, five of them live and open in a browser right now, each one measured on a real phone before it ships.',
  },
  {
    href: '/ai',
    eyebrow: 'Voice',
    title: 'AI voice agents',
    body: 'Agents that answer the calls a small business misses — booking, triage and after-hours reception, on the phone number they already have.',
  },
  {
    href: '/amenity',
    eyebrow: 'Amenity',
    title: AMENITY_BRAND,
    body: 'Curated smart markets for luxury residential buildings. Zero cost and zero work for the property.',
  },
];
---

<BaseLayout page={PAGES.home} ogAlt={`${FULL_NAME} — full-stack developer and founder in ${REGION}`}>
  <section class="hero">
    <div class="shell">
      <div style="display:flex;flex-direction:column;gap:2rem">
        <div>
          {/* The separators are present in the DOM text and hidden visually —
              see `.vh` in global.css for why. */}
          <h1 class="h1">
            <span class="hero__name">{FULL_NAME}</span>
            <span class="vh"> — </span>
            <span class="hero__role">Full-Stack Developer &amp; Founder</span>
            <span class="vh"> · </span>
            <span class="hero__region">{REGION}</span>
          </h1>
          {/* The one line that grounds the duality. Deliberately OUTSIDE the
              <h1>: check-textfit.mjs asserts that heading's exact string, and
              the heading is the SEO asset — this is context, not a title. */}
          {/* "Remote at CED, based here" — not "CED is here". The previous
              wording read as though the employer ran out of Bergen County,
              which is a false statement about a real company. Ruling (a):
              CED is named. */}
          <p class="hero__now">
            Remote full-stack developer at <strong>CED</strong>, building internal
            warehouse-operations software. Based in {REGION}; the job is remote.
            Founder the rest of the time.
          </p>
        </div>

        <div style="display:flex;flex-wrap:wrap;gap:2rem;align-items:flex-start">
          {
            /* Wired, not waiting: the day `public/ryan.jpg` exists the next
               build renders it here and drops the placeholder, with no edit to
               this file. Same 4:5 box either way, so the swap cannot shift the
               page. See src/assets.ts. */
            HAS_HEADSHOT ? (
              <img
                class="headshot"
                src={HEADSHOT_SRC}
                width={HEADSHOT_W}
                height={HEADSHOT_H}
                alt={`${FULL_NAME}, full-stack developer and founder in ${REGION}`}
                fetchpriority="high"
              />
            ) : (
              <Placeholder
                token={PLACEHOLDERS.photo}
                note="Drop a headshot here — 4:5 portrait, shot at 800×1000 or larger."
                shape="photo"
              />
            )
          }
          <div class="prose" style="flex:1 1 18rem">
            <p>
              I build software for people who need it to work on the first call. That is the
              day job — internal warehouse-operations software at CED, in React, TypeScript and
              C#/.NET, remote — and it is what I do with the ventures I run out of {REGION}: a
              web studio, an AI voice practice, an amenity company placing curated smart markets
              in luxury residential buildings, and a consumer AI app for fashion and styling.
            </p>
            <p>
              Writing code since {CODING_SINCE}, {YEARS_PROFESSIONAL} of those years
              professionally. If you found this page from an email I sent you, the short version
              is that I answer my own inbox and I ship my own work.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--plain">
    <div class="shell stack">
      <div class="reveal">
        <p class="eyebrow">What I run</p>
        <h2 class="h2 tick">The ventures</h2>
      </div>
      <div class="grid grid--3 reveal reveal--stagger" style="width:100%">
        {
          ventures.map((v) => (
            <a class="card card--link" href={v.href}>
              <p class="eyebrow">{v.eyebrow}</p>
              <h3 class="h3">{v.title}</h3>
              <p class="card__body">{v.body}</p>
              <span class="card__more">Read more →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell stack">
      <h2 class="h2 tick reveal">Where I work</h2>
      <div class="prose reveal">
        <p>
          I am in {REGION}, and the ventures run from here. The day job does not — CED is a
          national electrical distributor and I work with its teams remotely, which is exactly
          why the evenings belong to my own work.
        </p>
        <p>
          When a local business needs a {' '}<strong>Bergen County web developer</strong>, that
          is what site-factory is for — and the buildings and businesses I work with are close
          enough that I would rather drive to a first meeting than take it over video.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
