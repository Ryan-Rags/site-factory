---
/**
 * The web-studio page.
 *
 * The demo grid is built ENTIRELY from DEMO_LINK placeholder cards and links
 * nowhere. That is a hard rule, not a stub: the real demos are prospect mockups
 * built for businesses that have not signed, they are deliberately noindex, and
 * linking one from an indexed page would both expose a private pitch and drag it
 * into a crawler's view. Ryan fills a card in when a client signs and the site
 * is theirs to show. `check-placeholders.mjs` asserts five DEMO_LINK cards are
 * still here, so the grid cannot be quietly wired to live URLs.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import { EMAIL_DEV, PAGES, PLACEHOLDERS, REGION } from '../site';

/** Five slots. The labels describe the trade, not a named business. */
const demoSlots = [
  'Trades — welding, HVAC, electrical',
  'Auto — body shop, detailing, tires',
  'Home services — landscaping, roofing',
  'Food — restaurant, bakery, catering',
  'Professional — clinic, studio, office',
];

const included = [
  {
    title: 'Built for a phone first',
    body: 'Most of your customers arrive on a phone on a mediocre connection. That is the case I design for, and the one I measure.',
  },
  {
    title: 'Measured, not assumed',
    body: 'Every site gets a real Lighthouse run on a throttled mobile profile before it goes live, and you get the number.',
  },
  {
    title: 'Yours, and portable',
    body: 'Static hosting on a fast global network, no monthly platform lock-in, and the source is yours if you ever want to move.',
  },
  {
    title: 'Written, not filled in',
    body: 'Copy is written for your trade and your area. Nothing on your site is a claim I cannot back up about your business.',
  },
];
---

<BaseLayout
  page={PAGES.sites}
  ogAlt={`site-factory — fast, modern websites for ${REGION} businesses`}
>
  <section class="hero">
    <div class="shell stack">
      <p class="eyebrow">site-factory</p>
      <h1 class="h1">Fast, modern websites for Bergen County businesses</h1>
      <p class="lede">
        site-factory is my web studio:
        {' '}<strong style="color:var(--ink)">Bergen County web developer</strong> work for local
        businesses — sites that load fast on a phone, say something true about the business, and
        do not need a subscription to keep working.
      </p>
      <a class="btn" href={`mailto:${EMAIL_DEV}`}>Start a conversation</a>
    </div>
  </section>

  <section class="section section--plain">
    <div class="shell stack">
      <div>
        <p class="eyebrow">Recent work</p>
        <h2 class="h2 tick">Demos</h2>
      </div>
      <p class="lede">
        Live examples go here as clients sign off on showing them. Each slot below becomes one
        card linking to that site.
      </p>
      <div class="grid grid--3" style="width:100%">
        {
          demoSlots.map((slot) => (
            <div class="card">
              <h3 class="h3" style="font-size:1rem">{slot}</h3>
              <Placeholder
                token={PLACEHOLDERS.demoLink}
                note="Replace with the live client URL, business name and a one-line result."
                shape="tall"
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell stack">
      <h2 class="h2 tick">What you get</h2>
      <div class="grid grid--2" style="width:100%">
        {
          included.map((item) => (
            <div class="card">
              <h3 class="h3">{item.title}</h3>
              <p class="card__body">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <h2 class="h2 tick">Getting started</h2>
      <div class="prose">
        <p>
          Send me the name of your business and your current site if you have one. I will look at
          it, tell you plainly what is costing you calls, and quote the work. No retainer, no
          discovery phase you pay for.
        </p>
      </div>
      <a class="btn" href={`mailto:${EMAIL_DEV}`}>Email {EMAIL_DEV}</a>
    </div>
  </section>
</BaseLayout>
