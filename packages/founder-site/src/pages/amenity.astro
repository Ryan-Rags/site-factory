---
/**
 * Reads as a standalone company page, not as a section of a developer's site.
 * It wears the `amenity` chrome (brand wordmark, one CTA, no portfolio nav) and
 * the `amenity` surface (light, softer radii, muted brass instead of electric
 * azure), because the reader is a luxury-apartment property manager comparing
 * amenity vendors and nothing about that comparison is helped by looking like a
 * portfolio.
 *
 * HARD COPY RULE: the local part of the contact mailbox — the category word for
 * this business — must not appear anywhere a human or a crawler will read it:
 * visible text, <title>, meta description, or OG/Twitter text. The category is
 * "smart markets" and "curated markets" on this page, always. The address
 * itself is fine inside a `mailto:` href, which is where it stays.
 * `scripts/check-amenity-wording.mjs` fails the build if that slips.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { AMENITY_BRAND, EMAIL_AMENITY, PAGES, SUBJECT_AMENITY, mailto } from '../site';

const included = [
  {
    title: 'Stocked and serviced by us',
    body: 'Scheduled restocking, cleaning, and any service call. Your staff never touches the unit and never fields a question about it.',
  },
  {
    title: 'Insured and compliant',
    body: 'We carry the coverage and the certificates, and we hand your management company the paperwork before install day.',
  },
  {
    title: 'Wrapped to your interiors',
    body: 'Each cooler is custom-wrapped to match the finishes in your lobby or lounge — not a branded box parked in a corridor.',
  },
  {
    title: 'Zero cost to the building',
    body: 'No purchase, no lease, no revenue share to negotiate, no line item. We install, we operate, you get the amenity.',
  },
];

const assortment = [
  'Premium grab-and-go — cold-pressed juice, real-fruit smoothies, protein and breakfast',
  'Rotating local NJ makers, refreshed on a schedule so the shelf is never static',
  'Late-night and early-morning coverage, because the market is open whenever the lobby is',
];
---

<BaseLayout
  page={PAGES.amenity}
  ogAlt={`${AMENITY_BRAND} — curated smart markets for luxury residential buildings`}
  chrome="amenity"
  surface="amenity"
>
  <section class="hero">
    <div class="shell stack">
      <p class="eyebrow">{AMENITY_BRAND}</p>
      <h1 class="h1">Curated smart markets for luxury residential buildings</h1>
      <p class="lede">
        Tap-to-open smart coolers stocked with premium grab-and-go and rotating local NJ makers.
        Zero cost and zero work for the building: we handle stocking, service and insurance, with
        units custom-wrapped to match your interiors.
      </p>
      <a class="btn" href={mailto(EMAIL_AMENITY, SUBJECT_AMENITY)}>Request a proposal</a>
    </div>
  </section>

  <section class="section section--plain">
    <div class="shell stack">
      <div class="reveal">
        <p class="eyebrow">How it works</p>
        <h2 class="h2 tick">An amenity, not a machine</h2>
      </div>
      <div class="diagram-row">
      <div class="prose reveal">
        <p>
          A resident taps a card, the door unlocks, they take what they want and the door closes.
          No keypad, no coin slot, no spiral to jam and nothing for your front desk to apologize
          for. The unit reports its own inventory, so restocking happens before a shelf
          looks empty rather than after someone complains about it.
        </p>
      </div>
      {
        /* THE ONLY IMAGE ON THIS PAGE, AND IT IS A DRAWING ON PURPOSE.
           Alcove Markets has zero installs. A photograph, a rendered lobby or a
           screenshot of a unit's screen would each imply one, so the section
           gets a line-drawing of the product and a caption that says it is a
           drawing. Inline SVG, no request, no <script> — both are gated. It is
           built from the page's own tokens (`--surface`, `--line`, `--accent`
           on the amenity surface), so it cannot drift from the palette, and it
           carries no dimensions or specs, which would be invented numbers. */
      }
      <figure class="diagram reveal">
        <svg
          class="diagram__art"
          viewBox="0 0 320 260"
          width="320"
          height="260"
          fill="none"
          aria-hidden="true"
          focusable="false"
        >
          <defs>
            <clipPath id="cab">
              <rect x="104" y="14" width="112" height="222" rx="9" />
            </clipPath>
            <clipPath id="glass">
              <rect x="113" y="23" width="76" height="163" rx="5" />
            </clipPath>
          </defs>

          {/* the unit sits on a floor rather than floating */}
          <ellipse cx="160" cy="240" rx="74" ry="4" fill="var(--ink)" opacity="0.06" />
          <line
            x1="46"
            y1="240"
            x2="274"
            y2="240"
            stroke="var(--line)"
            stroke-width="1"
          />

          {/* cabinet */}
          <rect
            x="104"
            y="14"
            width="112"
            height="222"
            rx="9"
            fill="var(--surface)"
            stroke="var(--line)"
            stroke-width="1.5"
          />

          {/* glass door, its shelves, and what is on them — silhouettes only */}
          <rect
            x="113"
            y="23"
            width="76"
            height="163"
            rx="5"
            fill="var(--surface-alt)"
            stroke="var(--line)"
            stroke-width="1"
          />
          <g clip-path="url(#glass)">
            <rect x="119" y="29" width="58" height="2.5" rx="1.25" fill="var(--accent)" opacity="0.4" />
            <g fill="var(--accent)" opacity="0.34">
              <rect x="120" y="47" width="9" height="27" rx="4.5" />
              <rect x="148" y="52" width="11" height="22" rx="5.5" />
              <rect x="176" y="46" width="9" height="28" rx="4.5" />
              <rect x="133" y="101" width="11" height="21" rx="2.5" />
              <rect x="161" y="101" width="11" height="21" rx="2.5" />
              <rect x="121" y="146" width="10" height="24" rx="5" />
              <rect x="164" y="150" width="14" height="20" rx="3" />
            </g>
            <g fill="var(--ink-muted)" opacity="0.26">
              <rect x="133" y="51" width="10" height="23" rx="5" />
              <rect x="162" y="49" width="10" height="25" rx="5" />
              <rect x="119" y="103" width="11" height="19" rx="2.5" />
              <rect x="147" y="99" width="11" height="23" rx="2.5" />
              <rect x="175" y="102" width="10" height="20" rx="2.5" />
              <rect x="135" y="149" width="10" height="21" rx="5" />
              <rect x="149" y="152" width="12" height="18" rx="3" />
            </g>
            <g stroke="var(--line)" stroke-width="1">
              <line x1="113" y1="74" x2="189" y2="74" />
              <line x1="113" y1="122" x2="189" y2="122" />
              <line x1="113" y1="170" x2="189" y2="170" />
            </g>
            {/* the one gloss that makes it read as glass */}
            <path d="M120 23 L146 23 L118 186 L106 186 Z" fill="var(--surface)" opacity="0.5" />
          </g>
          {/* tap-to-open reader, and the signal leaving it */}
          <circle cx="203" cy="100" r="7" fill="var(--surface)" stroke="var(--accent)" stroke-width="1.3" />
          <circle cx="203" cy="100" r="2" fill="var(--accent)" opacity="0.7" />
          <g stroke="var(--accent)" fill="none" stroke-linecap="round">
            <path d="M217.1 85.9 A 20 20 0 0 1 217.1 114.1" stroke-width="1.3" opacity="0.55" />
            <path d="M222.8 80.2 A 28 28 0 0 1 222.8 119.8" stroke-width="1.2" opacity="0.32" />
            <path d="M228.5 74.5 A 36 36 0 0 1 228.5 125.5" stroke-width="1.1" opacity="0.16" />
          </g>

          {/* the custom wrap: a graphic treatment, not a branded box */}
          <g clip-path="url(#cab)">
            <rect x="104" y="196" width="112" height="40" fill="var(--accent)" opacity="0.12" />
            <path d="M104 232 L216 196 L216 214 L104 236 Z" fill="var(--accent)" opacity="0.16" />
            <circle cx="126" cy="212" r="7" fill="none" stroke="var(--accent)" stroke-width="1.2" opacity="0.55" />
            <line x1="140" y1="209" x2="176" y2="209" stroke="var(--accent)" stroke-width="1.5" opacity="0.5" stroke-linecap="round" />
            <line x1="140" y1="216" x2="164" y2="216" stroke="var(--accent)" stroke-width="1.5" opacity="0.3" stroke-linecap="round" />
          </g>
          <line x1="104" y1="196" x2="216" y2="196" stroke="var(--line)" stroke-width="1" />
        </svg>
        <figcaption class="diagram__caption">
          Illustration &mdash; a slim cooler, custom-wrapped to a building&rsquo;s finishes.
        </figcaption>
      </figure>
      </div>
      <div class="grid grid--2 reveal reveal--stagger" style="width:100%">
        {
          included.map((item) => (
            <div class="card">
              <h3 class="h3">{item.title}</h3>
              <p class="card__body">{item.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="shell stack">
      <div class="reveal">
        <p class="eyebrow">What is on the shelf</p>
        <h2 class="h2 tick">Curated, and rotated</h2>
      </div>
      <ul class="list reveal">
        {assortment.map((line) => <li>{line}</li>)}
      </ul>
      <div class="prose reveal">
        <p>
          The assortment is chosen per building. A lease-up full of young professionals and an
          established tower with long-term residents do not want the same shelf, and the local
          makers we rotate in are the part residents actually talk about.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell stack">
      <h2 class="h2 tick reveal">Bringing one to your building</h2>
      <div class="prose reveal">
        <p>
          Tell us the building, the space you have in mind, and roughly how many units it serves.
          We will come look at it, propose a placement and an assortment, and handle the rest.
        </p>
      </div>
      <a class="btn reveal" href={mailto(EMAIL_AMENITY, SUBJECT_AMENITY)}>Request a proposal</a>
    </div>
  </section>
</BaseLayout>
