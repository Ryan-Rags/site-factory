{
  "name": "@site-factory/founder-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ryan Raghubans' public founder/credibility site for raghubans.com. Standalone Astro app; not part of the client pipeline.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/check-indexable.mjs && node scripts/check-metadata.mjs && node scripts/check-amenity-wording.mjs && node scripts/check-placeholders.mjs && node scripts/check-no-forms.mjs && node scripts/check-headers.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check:indexable": "node scripts/check-indexable.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "check:amenity-wording": "node scripts/check-amenity-wording.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:no-forms": "node scripts/check-no-forms.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:textfit": "node scripts/check-textfit.mjs",
    "gen:og": "node scripts/gen-og.mjs",
    "clean": "node -e \"const{rmSync}=require('node:fs');for(const d of ['dist','.astro'])rmSync(d,{recursive:true,force:true})\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.2.1",
    "astro": "^5.2.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "playwright": "^1.49.1",
    "typescript": "^5.7.3"
  }
}
